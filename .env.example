# Copy this file to .env.local and fill in the values.
# Without the Supabase values the site runs on built-in sample content (handy for previews).

# Public address of the site, used for SEO links and the sitemap
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) for inquiry emails
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend
EMAIL_FROM="Oloning'o Travel <hello@your-domain.com>"
# Where new inquiries are sent
INQUIRY_NOTIFY_EMAIL=info@your-domain.com

# Any long random string, used to anonymise IP addresses for spam rate limiting
RATE_LIMIT_SALT=change-me-to-a-long-random-string
